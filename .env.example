# ---------------------------------------------------------------------------
# OpenCam configuration. Copy to `.env` and edit; every value has a working
# default, so an empty .env is a valid .env.
#
#   cp .env.example .env && docker compose up --build
# ---------------------------------------------------------------------------

# --- ports -----------------------------------------------------------------
# 0.0.0.0 publishes an unauthenticated camera API to the whole LAN.
# Only widen this together with OPENCAM_API_TOKEN.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
FRONTEND_PORT=5173
# nginx proxies /api and /ws, so this bind governs LAN exposure too.
FRONTEND_BIND=127.0.0.1
# Where nginx proxies /api and /ws. With host networking this is loopback.
BACKEND_UPSTREAM=127.0.0.1:8080

LOG_LEVEL=INFO

# --- compute budget --------------------------------------------------------
# Concurrent inference jobs across ALL sessions. Each worker owns one model
# bundle (~250 MB RSS), so this is the memory/CPU dial that matters most.
MAX_WORKERS=4
# Threads handed to ONNX Runtime / OpenCV inside a single job.
INFERENCE_THREADS=2
# Frames are downscaled to this longest edge before detection + face work.
# 640 is the YOLOv8 native input; 480 buys ~35% latency at some small-object recall.
INFERENCE_MAX_SIDE=640
# Soft FPS ceiling for the inference loop. 40 ms => at most 25 passes/second.
# Raise to 66 (15 fps) on a weak CPU; lower to 25 (40 fps) on a strong one.
MIN_INFERENCE_INTERVAL_MS=40
# Annotations older than this are dropped instead of drawn over stale content.
ANNOTATION_TTL_MS=750

BACKEND_CPUS=4.0
BACKEND_MEMORY=4g

# --- object detection (YOLOv8n) --------------------------------------------
DETECTOR_ENABLED=1
DETECTOR_CONF=0.35
DETECTOR_IOU=0.45

# --- face detection + recognition (YuNet + SFace) --------------------------
FACE_ENABLED=1
# SFace cosine similarity. OpenCV's reference value is 0.363.
# Raise toward 0.45 for fewer false identities, lower toward 0.30 for fewer misses.
FACE_MATCH_THRESHOLD=0.363
FACE_MAX_FACES=6
# How often the /faces directory is re-scanned for new photos, in seconds.
FACE_RELOAD_INTERVAL_S=5

# --- emotion (MobileFaceNet FER) -------------------------------------------
EMOTION_ENABLED=1
EMOTION_MAX_FACES=3
# Report weakly-confident neutral with a pensive runner-up as "Thinking".
EMOTION_THINKING_HEURISTIC=1
EMOTION_THINKING_MAX_CONF=0.55

# --- OCR (PP-OCRv3 detection + CRNN recognition) ---------------------------
OCR_ENABLED=1
# OCR runs on every Nth inference pass. Lower = more responsive, more CPU.
OCR_EVERY_N=6
OCR_MAX_REGIONS=8
OCR_MIN_CONF=0.5

# --- distance estimation ---------------------------------------------------
DISTANCE_ENABLED=1
# THE dial that matters. Monocular distance scales linearly with it, so a wrong
# FOV means a proportionally wrong distance. Typical webcams: 55-78 deg.
# Calibrate: sit at a measured 1.00 m, read get('distance'), then set
#   CAMERA_HFOV_DEG = 2 * degrees(atan( tan(radians(60/2)) * reported / 1.00 ))
CAMERA_HFOV_DEG=60
# Mean adult interpupillary distance (m). Lower it for a child-facing deployment.
FACE_IPD_M=0.063
FACE_WIDTH_M=0.150

# --- people fusion / tracking ----------------------------------------------
PEOPLE_ENABLED=1
# Inference passes a person may go unseen before their tracking id is retired.
PEOPLE_MAX_MISSES=8

# --- server-side ingest (IP cameras / RTSP / files) -------------------------
INGEST_ENABLED=1
# Allowlist of URL schemes the /api/ingest endpoint will open. Narrow this in
# production: an unrestricted fetcher is an SSRF primitive.
# `file` and `device` read local resources - add them only deliberately.
INGEST_ALLOWED_SCHEMES=rtsp,rtsps,rtmp,rtmps,https
# 1 lets /api/ingest reach loopback/private/link-local addresses, which
# includes cloud metadata (169.254.169.254). Enable only on a trusted LAN.
INGEST_ALLOW_PRIVATE=0
INGEST_TIMEOUT_S=15

# --- rendering -------------------------------------------------------------
DRAW_LABELS=1
DRAW_HUD=1

# --- webrtc ----------------------------------------------------------------
STUN_URL=stun:stun.l.google.com:19302
# Sessions with no publisher, viewer or dashboard are reaped after this long.
SESSION_IDLE_TIMEOUT_S=60

# --- gpu (optional) --------------------------------------------------------
# Set to onnxruntime-gpu and rebuild to use CUDA for object detection.
ONNXRUNTIME_PACKAGE=onnxruntime
